# --- Binarios pesados del handoff (NO versionados) ---------------------------
# 113 MB de fotos y video del bundle de diseño. Se quedan en el disco de trabajo
# y su destino final es Sanity (y de ahí, los exports del dataset).
# El resto de `design/` —HTML del prototipo, specs, JSON del catálogo, GeoJSON,
# logos SVG, LEEME— SÍ se versiona: es el contrato de fidelidad visual.
design/publicar/uploads/
design/publicar/assets/catalogo/

# --- Script de importación de contenido de referencia -----------------------
# Mapa local ruta-de-archivo -> assetId de Sanity, para no volver a subir lo
# ya subido. No aporta nada fuera de esta máquina.
scripts/.assets-subidos.json

# Portadas descargadas de origen remoto (miniatura del video de YouTube). Se
# suben a Sanity y de ahí salen: la caché local solo evita bajarlas dos veces.
scripts/.medios-descargados/

# Medios descargados de Sanity en el build (video del hero, archivos).
# No se versionan: los regenera `npm run prebuild` desde el CMS.
public/medios/
src/lib/medios.json
