# Configuración pública del build de QA. NO contiene secretos: el projectId y las
# URLs son visibles en el sitio publicado. Se versiona a propósito, para que el
# build de Cloudflare sea reproducible sin cargar variables a mano en el panel.
# Los secretos (token de lectura de Sanity, credenciales de Cloudflare) viven
# solo en `.env`, que no se versiona.
PUBLIC_SANITY_PROJECT_ID="egpui9al"
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_PREVIEW_URL="https://preview.ceramica-carabobo.workers.dev"
SITE_URL="https://qa.ceramica-carabobo.workers.dev"
