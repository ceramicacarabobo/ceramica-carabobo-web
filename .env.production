# Configuración pública del despliegue de PRODUCCIÓN (cuenta del cliente).
# Se versiona a propósito: acá no hay secretos, solo identificadores públicos.
# Los tokens viven en las variables del worker en Cloudflare, nunca acá.

PUBLIC_SANITY_PROJECT_ID="dnjm4k7p"
PUBLIC_SANITY_DATASET="production"

# Dirección temporal mientras el dominio del cliente sigue apuntando a su sitio
# anterior. EL DÍA DEL CAMBIO DE DOMINIO se reemplaza por el dominio real: de
# acá salen los canonical, las etiquetas Open Graph y el sitemap.
SITE_URL="https://prd.ceramicacarabobo.workers.dev"
PUBLIC_SANITY_STUDIO_URL="https://prd.ceramicacarabobo.workers.dev/admin"

# "produccion" es lo ÚNICO que levanta el bloqueo de indexación (robots.txt y
# la etiqueta noindex). Se cambia recién cuando el dominio real esté apuntando
# y el sitio verificado — no antes.
PUBLIC_ENTORNO="pruebas"
