{
  "name": "ceramica-carabobo-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:preview": "PUBLIC_SANITY_VISUAL_EDITING_ENABLED=true astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && wrangler deploy -c dist/client/wrangler.json",
    "deploy:preview": "npm run build:preview && wrangler deploy -c dist/server/wrangler.json --name preview",
    "sanity:export": "sanity dataset export production backups/dataset.tar.gz"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.4",
    "@astrojs/react": "^6.0.4",
    "@fontsource-variable/open-sans": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.0.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.10.1",
    "astro": "^7.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.0",
    "sanity": "^6.10.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.83.0"
  }
}
