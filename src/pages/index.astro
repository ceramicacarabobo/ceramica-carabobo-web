---
/**
 * Home — versión mínima de la Fase 1 (esqueleto).
 * Muestra el contenido que ya viene del CMS y, mientras no lo haya, el estado
 * del esqueleto. Las secciones reales del diseño (hero con video, ambientes,
 * proyectos, historia, profesionales, encuéntranos) se implementan en la Fase 2.
 * Nada de texto de marca está escrito en el código: si no está en el CMS, no se muestra.
 */
import Base from '~/layouts/Base.astro'
import {contarPorEstado, getAjustes, getDistribuidores, getHome, getMaterias, getProductos, sanityConfigurado} from '~/lib/data'

const [ajustes, home, productos, distribuidores, materias] = await Promise.all([
  getAjustes(),
  getHome(),
  getProductos(),
  getDistribuidores(),
  getMaterias(),
])

const hayHero = Boolean(home.hero.titular || home.hero.eyebrow)
const porEstado = contarPorEstado(distribuidores)
---

<Base titulo={ajustes.titulo} descripcion={ajustes.descripcion} noIndex={!sanityConfigurado}>
  {
    hayHero && (
      <section class="hero contenedor">
        {home.hero.eyebrow && <p class="overline hero__eyebrow">{home.hero.eyebrow}</p>}
        {home.hero.titular && <h1 class="hero__titular">{home.hero.titular}</h1>}
      </section>
    )
  }

  {
    !hayHero && (
      <section class="esqueleto contenedor">
        <p class="overline">Fase 1 · Esqueleto</p>
        <h1 class="esqueleto__titular">El sitio está en pie; falta cargarle contenido.</h1>
        <p class="esqueleto__texto">
          La cáscara compartida, el enrutado y el administrador ya funcionan. El contenido de esta
          página se edita en <a href="/admin">/admin</a> y se publica desde ahí.
        </p>
      </section>
    )
  }

  <section class="estado contenedor" aria-labelledby="estado-titulo">
    <h2 id="estado-titulo" class="overline">Estado del contenido</h2>
    <dl class="estado__grilla">
      <div class="estado__dato">
        <dt>Conexión con el CMS</dt>
        <dd>{sanityConfigurado ? 'configurada' : 'pendiente (PUBLIC_SANITY_PROJECT_ID)'}</dd>
      </div>
      <div class="estado__dato">
        <dt>Productos</dt>
        <dd>{productos.length}</dd>
      </div>
      <div class="estado__dato">
        <dt>Distribuidores</dt>
        <dd>{distribuidores.length}{porEstado.length > 0 && ` en ${porEstado.length} estados`}</dd>
      </div>
      <div class="estado__dato">
        <dt>Materias</dt>
        <dd>{materias.length}</dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .hero,
  .esqueleto {
    padding-block: var(--space-section);
    max-width: 44ch;
    margin-inline: auto;
  }

  .hero__eyebrow,
  .esqueleto .overline {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .hero__titular,
  .esqueleto__titular {
    font: var(--text-display);
    letter-spacing: var(--tracking-display-light);
  }

  .esqueleto__texto {
    margin-top: var(--space-6);
    font: var(--text-body-lg);
    color: var(--color-text-secondary);
  }

  .estado {
    padding-bottom: var(--space-section);
  }

  .estado__grilla {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--border-width);
    background: var(--color-border-hairline);
    border: var(--border-width) solid var(--color-border-hairline);
  }

  .estado__dato {
    background: var(--color-surface-raised);
    padding: var(--space-4);
  }

  .estado__dato dt {
    font: var(--text-caption);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-uppercase-sm);
  }

  .estado__dato dd {
    margin: var(--space-2) 0 0;
    font: var(--text-data);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 760px) {
    .estado__grilla {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
