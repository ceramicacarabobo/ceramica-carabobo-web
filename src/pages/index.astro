---
/**
 * Home. La composición y el orden de las secciones son FIJOS (no editables);
 * el contenido de cada una viene del CMS y cada sección se oculta sola si no
 * llega a su mínimo — regla de contenido defensivo del handoff.
 *
 * Tramo central v2 (2026-09-04, `design/handoff-p1-v2/README.md`): 01 Ambientes ·
 * 02 Compara · 03 Historia · 04 Profesionales · 05 Encuéntranos, con la banda de
 * obra a sangre entre Compara e Historia. Proyectos salió del home por falta de
 * material fotográfico de obra; su contenido se conserva en el CMS y el
 * componente sigue en `components/home/Proyectos.astro` para volver a colgarlo
 * cuando el material llegue.
 */
import Base from '~/layouts/Base.astro'
import Hero from '~/components/home/Hero.astro'
import Ambientes from '~/components/home/Ambientes.astro'
import Cita from '~/components/home/Cita.astro'
import Compara from '~/components/home/Compara.astro'
import BandaObra from '~/components/home/BandaObra.astro'
import Historia from '~/components/home/Historia.astro'
import Profesionales from '~/components/home/Profesionales.astro'
import Encuentranos from '~/components/home/Encuentranos.astro'
import {getAjustes, getDistribuidores, getHome} from '~/lib/data'
import {empresa} from '~/lib/estructurados'

const [ajustes, home, distribuidores] = await Promise.all([getAjustes(), getHome(), getDistribuidores()])

const hayHero = Boolean(home.hero.titular || home.hero.videoUrl || home.hero.capas.length > 0)

// Datos estructurados de la empresa. Van solo acá: se declaran una vez por sitio.
const sitio = (Astro.site ?? new URL(Astro.url.origin)).href
const datosEmpresa = empresa({
  nombre: ajustes.titulo,
  sitio,
  descripcion: ajustes.descripcion,
  direccion: ajustes.direccion,
  telefono: ajustes.telefono,
  correo: ajustes.correo,
  anioFundacion: ajustes.anioFundacion,
  redes: ajustes.redes.map((red) => red.url).filter(Boolean),
})
---

<Base titulo={ajustes.titulo} descripcion={ajustes.descripcion} sobreHero={hayHero}>
  {hayHero && <Hero hero={home.hero} />}

  <Ambientes ambientes={home.ambientes} />
  <Cita cita={home.cita} />
  <Compara comparador={home.comparador} />
  <BandaObra banda={home.banda} />
  <Historia historia={home.historia} />
  <Profesionales profesionales={home.profesionales} />
  <Encuentranos encuentranos={home.encuentranos} distribuidores={distribuidores} />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEmpresa)} />

  {
    !hayHero && (
      <section class="esqueleto">
        <p class="overline">Sin contenido</p>
        <h1 class="esqueleto__titular">La home todavía no tiene contenido cargado.</h1>
        <p class="esqueleto__texto">
          Se edita en <a href="/admin">/admin</a>, en la página Home, y se publica desde ahí.
        </p>
      </section>
    )
  }
</Base>

<style>
  .esqueleto {
    padding: var(--space-section) var(--space-gutter-page);
    max-width: 44ch;
    margin-inline: auto;
  }

  .esqueleto .overline {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .esqueleto__titular {
    font: var(--text-heading-xl);
  }

  .esqueleto__texto {
    margin-top: var(--space-6);
    font: var(--text-body-lg);
    color: var(--color-text-secondary);
  }
</style>
