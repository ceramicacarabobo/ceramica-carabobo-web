---
/**
 * Cáscara compartida del sitio (requisito nº1 del handoff):
 * una sola app, header y pie que NO se remontan al navegar, sin destello
 * blanco, con URL propia por página.
 *   - ClientRouter  → navegación con View Transitions (mejora progresiva).
 *   - transition:persist → la cáscara sobrevive el cambio de página.
 */
import {ClientRouter} from 'astro:transitions'
import {VisualEditing} from '@sanity/astro/visual-editing'

// Exactamente los pesos que declara el diseño (Work Sans 300/500/600 + Open Sans 400),
// con el nombre de familia que usan los tokens. Las variables de @fontsource-variable
// se llaman "Work Sans Variable" y hacían que el sitio cayera a Arial.
import '@fontsource/work-sans/300.css'
import '@fontsource/work-sans/400.css'
import '@fontsource/work-sans/500.css'
import '@fontsource/work-sans/600.css'
import '@fontsource/open-sans/400.css'
import '~/theme/tokens.css'
import '~/theme/base.css'

import Telon from '~/components/shell/Telon.astro'
import Header from '~/components/shell/Header.astro'
import Footer from '~/components/shell/Footer.astro'
import {getAjustes, getMaterias, getProductos, visualEditingHabilitado} from '~/lib/data'

interface Props {
  titulo: string
  descripcion?: string
  imagenOG?: string
  noIndex?: boolean
  /** La página abre con hero a sangre: la cabecera va transparente encima. */
  sobreHero?: boolean
}

const {titulo, descripcion, imagenOG, noIndex = false, sobreHero = false} = Astro.props

// QA y preview nunca deben indexarse: el sitio todavía muestra datos de ejemplo
// (distribuidores inventados, fotos ajenas, hitos sin validar). Solo el despliegue
// marcado como producción es indexable.
const esProduccion = import.meta.env.PUBLIC_ENTORNO === 'produccion'
const sinIndexar = noIndex || !esProduccion

const [ajustes, materiasCms, productos] = await Promise.all([getAjustes(), getMaterias(), getProductos()])

// El conteo de diseños por materia SE DERIVA del catálogo — nunca se escribe a mano
// (regla del prototipo). Solo entran al megamenú las materias con foto y con productos.
const materias = materiasCms
  .map((materia) => ({
    ...materia,
    total: productos.filter((producto) => producto.materia === materia.nombre).length,
  }))
  .filter((materia) => materia.total > 0 && materia.fotoTextura)
  .sort((a, b) => b.total - a.total)
  .slice(0, 6)

const tituloPagina = titulo === ajustes.titulo ? titulo : `${titulo} — ${ajustes.titulo}`
const meta = descripcion ?? ajustes.descripcion
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    {meta && <meta name="description" content={meta} />}
    <link rel="canonical" href={canonical} />
    {sinIndexar && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ajustes.titulo} />
    <meta property="og:title" content={tituloPagina} />
    {meta && <meta property="og:description" content={meta} />}
    <meta property="og:url" content={canonical} />
    {imagenOG && <meta property="og:image" content={new URL(imagenOG, canonical).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#55000F" />
    <link rel="icon" href="/assets/logo-iso.svg" type="image/svg+xml" />

    <ClientRouter />

    <script is:inline>
      // Bandera única del movimiento de entrada: "hay JavaScript y el visitante no pidió menos
      // movimiento". De ella cuelgan los estados INICIALES —los que dejan algo invisible o
      // recortado— del marcador de carga de imagen (`base/Imagen.astro`), del fundido de los
      // encabezados (`base/Reveal.astro`) y de la máscara y el filete (`theme/base.css`).
      //
      // Se prende acá, SÍNCRONO y en el head, y no en el script del componente: los scripts de
      // Astro son diferidos y el navegador ya habría pintado el contenido, que se vería
      // apagarse. Sin JavaScript la bandera no existe y todo nace en su estado final.
      ;(function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

        var prender = function () {
          document.documentElement.setAttribute('data-movimiento', '')
        }

        prender()
        // El cambio de página con View Transitions copia los atributos de <html> del documento
        // nuevo, o sea que borra este. `astro:after-swap` corre antes de pintar.
        document.addEventListener('astro:after-swap', prender)
      })()
    </script>
  </head>

  <body>
    <Telon />

    <a class="skip-link" href="#contenido">Ir al contenido</a>

    <!-- `transition:persist` NO se pone acá: sobre un componente Astro llega como
         prop y se pierde si el componente no la reenvía. Header y Footer la declaran
         en su propio elemento raíz. -->
    <Header sobreHero={sobreHero} materias={materias} />

    <!-- La cabecera persiste entre páginas; este atributo es el que le dice, después
         del cambio, si la página nueva abre con hero a sangre. -->
    <main id="contenido" data-sobre-hero={sobreHero ? '' : undefined}>
      <slot />
    </main>

    <Footer ajustes={ajustes} />

    <VisualEditing enabled={visualEditingHabilitado} />
  </body>
</html>
