---
/**
 * Sección "03 · Profesionales" de la home: split 50/50 imagen + texto.
 *
 * El prototipo (`design/publicar/index.html`, bloque "PROFESIONALES (split
 * 50/50)") arma la mitad izquierda como un tile de video de instalación —
 * foto de portada, velo, botón de play de 72px y etiqueta "Video · 3:47"— y la
 * derecha con título, bajada y el bloque "Conecta con nuestras redes" con
 * Instagram, YouTube y TikTok como botones outline vinotinto.
 *
 * Los dos elementos existían en el diseño pero no en el contrato de datos, así
 * que se les dio lugar en el CMS en vez de hardcodearlos (CLAUDE.md: "textos de
 * marca nunca hardcodeados"):
 *   - el video y su etiqueta viven en `home.profesionales` (son de la sección);
 *   - las redes viven en `ajustes.redes` (son dato de sitio, no de sección), y
 *     por eso esta sección las pide al adaptador en vez de recibirlas por prop:
 *     `index.astro` compone secciones, no reparte ajustes globales.
 * Lo único hardcodeado es el dibujo del icono de cada red y el rótulo del
 * bloque, que son diseño, no contenido — igual que los rótulos "Ciudad" o
 * "Formato" de la ficha de Proyectos.
 *
 * FACHADA DE VIDEO (autosuficiencia, plan maestro §3.3). El video de
 * instalación vive hoy en el canal de YouTube, y un embed normal descarga
 * scripts de terceros con solo abrir la página: prohibido. Así que el tile es
 * una fachada — portada nuestra (subida a Sanity y procesada en el build) + el
 * botón de play del diseño — y el iframe de `youtube-nocookie.com` se crea
 * SOLO al pulsar. Mientras nadie pulse, la home no hace ni una petición a
 * terceros. Si algún día cargan el mp4 propio, el adaptador entrega
 * `video.tipo === 'archivo'` y la misma fachada abre un `<video>` local: el
 * componente no cambia.
 *
 * Accesibilidad: la fachada es un `<button>` real (no un `<a href="#">`), con
 * `aria-label` que nombra el video por su título y anillo de foco on-dark
 * (brand-300, como manda el comentario de `--color-border-focus`). El play y
 * la etiqueta son decorativos para el lector de pantalla: lo que se anuncia es
 * el botón.
 *
 * Proporciones del prototipo: la mitad de imagen no lleva ratio propio, es un
 * bloque de `min-height: clamp(280px,42vw,520px)` con la foto a `cover`
 * llenándolo; así ambas mitades miden lo mismo aunque el texto crezca. El
 * bloque editorial va centrado en vertical con `padding: clamp(32px,5vw,80px)`
 * y `gap: clamp(20px,2.2vw,28px)`.
 *
 * Reflow: replica el switch a una columna bajo 760px que usa `proSplitCols`
 * en el prototipo (mobile 1fr, desktop 1fr 1fr) — el mismo breakpoint que
 * Proyectos y Encuéntranos, no el de 1024.
 *
 * Ojo con el scope de Astro: `Reveal` no reenvía el atributo de scope del
 * padre a su raíz, así que lo que estiliza el elemento que produce
 * (`.profesionales__texto`) va con `:global()` colgando de `.profesionales`,
 * que sí lo lleva. Sin eso el texto se quedaba sin padding ni centrado. El
 * marco ya no pasa por `Reveal`, pero conserva `:global()` porque las reglas
 * que lo nombran alcanzan también a la foto, que la produce `Imagen`.
 *
 * Contenido defensivo: sin título ni texto no hay nada que editorializar y la
 * sección entera se oculta. Sin foto de sección ni portada de video, el bloque
 * editorial ocupa el ancho completo en vez de dejar media caja vacía. Sin
 * video no hay play ni etiqueta: queda la foto sola. Sin redes cargadas, el
 * bloque "Conecta con nuestras redes" no aparece.
 */
import Imagen from '~/components/base/Imagen.astro'
import Reveal from '~/components/base/Reveal.astro'
import Seccion from '~/components/base/Seccion.astro'
import {getAjustes, type Home} from '~/lib/data'

interface Props {
  profesionales: Home['profesionales']
}

const {profesionales} = Astro.props

/**
 * Iconos de las redes de la lista cerrada (`sanity/lib/listas.ts`). Los tres
 * del diseño están copiados del prototipo; Facebook y LinkedIn siguen el mismo
 * trazo (24×24, stroke 2, sin relleno) para que no desentonen si el cliente
 * los carga.
 */
const ICONOS: Record<string, string> = {
  Instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>',
  YouTube:
    '<path d="M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49 49 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49 49 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path>',
  TikTok: '<circle cx="8" cy="18" r="4"></circle><path d="M12 18V2l7 4"></path>',
  Facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>',
  LinkedIn:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle>',
}

const ajustes = await getAjustes()
const redes = ajustes.redes.filter((red) => red.nombre && red.url)

const video = profesionales.video
// La portada del video manda sobre la foto de la sección: es el fotograma de
// lo que se va a reproducir. Sin portada propia, la foto de sección hace de tal.
const portada = video?.portada ?? profesionales.imagen

// La portada del video es un fotograma 16:9 y no llena la caja sin recortarse;
// una foto propia sí. Se distingue para encuadrar cada una como corresponde.
const esPortadaDeVideo = Boolean(video?.portada)

const hayTextos = Boolean(profesionales.titulo || profesionales.texto)
const hayImagen = Boolean(portada)
const hayRedes = redes.length > 0

/** El botón se anuncia por el título real del video cuando el CMS lo trae. */
const etiquetaBoton = video?.titulo
  ? `Reproducir el video: ${video.titulo}`
  : 'Reproducir el video de instalación'
---

{
  hayTextos && (
    <Seccion
      como="section"
      id="profesionales"
      class="profesionales"
      fondo="base"
      aria-labelledby={profesionales.titulo ? 'profesionales-titulo' : undefined}
    >
      <div class:list={['profesionales__grid', !hayImagen && 'profesionales__grid--sin-imagen']}>
        {portada && (
          /* Contenido repetido: entra ya visible y conserva solo la máscara. */
          <div class="profesionales__marco" data-mascara data-portada={esPortadaDeVideo ? 'video' : undefined}>
            {
              esPortadaDeVideo && (
                <div class="profesionales__relleno" aria-hidden="true">
                  <Imagen imagen={portada} sizes="(min-width: 760px) 50vw, 100vw" ancho={760} />
                </div>
              )
            }
            <Imagen imagen={portada} sizes="(min-width: 760px) 50vw, 100vw" class="profesionales__foto" />
            {video && (
              <button
                type="button"
                class="profesionales__fachada"
                aria-label={etiquetaBoton}
                data-video-tipo={video.tipo}
                data-video-id={video.youtubeId}
                data-video-url={video.url}
                data-video-titulo={video.titulo ?? 'Video de instalación'}
              >
                <span class="profesionales__velo" />
                <span class="profesionales__play" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <path d="M8 5.14v14l11-7-11-7z" />
                  </svg>
                </span>
                {video.etiqueta && <span class="profesionales__videoetiqueta">{video.etiqueta}</span>}
              </button>
            )}
          </div>
        )}
        <Reveal como="div" indice={hayImagen ? 1 : 0} class="profesionales__texto">
          {profesionales.etiqueta && (
            <p class="profesionales__eyebrow">
              <span class="profesionales__numero">04</span> · {profesionales.etiqueta}
            </p>
          )}
          {profesionales.titulo && (
            <h2 id="profesionales-titulo" class="profesionales__titulo">
              {profesionales.titulo}
            </h2>
          )}
          {profesionales.texto && <p class="profesionales__bajada">{profesionales.texto}</p>}
          {hayRedes && (
            <div class="profesionales__redes">
              <p class="profesionales__redes-rotulo">Conecta con nuestras redes</p>
              <ul class="profesionales__redes-lista">
                {redes.map((red) => (
                  <li>
                    <a
                      class="profesionales__red"
                      href={red.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {ICONOS[red.nombre] && (
                        <svg
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          set:html={ICONOS[red.nombre]}
                        />
                      )}
                      {red.nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </Reveal>
      </div>
    </Seccion>
  )
}

<style>
  .profesionales__grid {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-surface-sunken);
  }

  /* Caja de medio del prototipo: alto propio mínimo y la foto llenándolo. */
  .profesionales :global(.profesionales__marco) {
    position: relative;
    min-height: clamp(280px, 42vw, 520px);
    min-width: 0;
    overflow: hidden;
  }

  /*
   * Portada de video: los fotogramas son 16:9 y esta caja es más alta (1,25), así
   * que llenarla recortaba por los lados y se comía el título y el logo del video.
   * Se muestra el fotograma completo, centrado, sobre el fondo oscuro: es el
   * encuadre que espera cualquiera que reconozca un reproductor.
   * Una foto vertical cargada desde el CMS sigue llenando la caja como en el diseño.
   */
  .profesionales :global(.profesionales__marco[data-portada='video']) {
    background: var(--color-surface-inverse-deep);
  }

  /*
   * Relleno desenfocado: una copia del mismo fotograma, ampliada y borrosa,
   * ocupa el sobrante en vez de dejar bandas negras. Es el recurso que usan los
   * reproductores cuando la proporción del video no calza con su caja, y aquí
   * evita las dos cosas malas: recortar el fotograma o enmarcarlo en negro.
   * Es decorativo, así que va oculto para lectores de pantalla.
   */
  .profesionales__relleno {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* El envoltorio de imagen reserva la proporción del archivo (16:9) y dejaba
     el sobrante inferior al fondo oscuro: de ahí la franja negra. Acá tiene que
     estirarse a toda la caja. */
  .profesionales__relleno :global(.imagen) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    background: transparent;
  }

  .profesionales__relleno :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
    filter: blur(28px) saturate(1.1) brightness(0.62);
  }

  /* La portada del video casi nunca tiene la proporción del tile, así que se
     encaja entera (`object-fit: contain`) y el sobrante lo rellena la capa
     borrosa de atrás. Tiene que quedar CENTRADA en los dos ejes: con
     `align-items` sola centraba en vertical y en horizontal se pegaba al borde
     izquierdo, así que el marco borroso aparecía solo del lado derecho. No se
     nota con una portada 16:9 —llena el ancho y solo sobra alto— pero sí con
     cualquier otra que suba el cliente. */
  .profesionales :global(.profesionales__marco[data-portada='video'] .profesionales__foto) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* El wrapper de imagen trae superficie propia para reservar la proporción;
       acá estorba: taparía el fondo oscuro de las bandas. */
    background: transparent;
  }

  .profesionales :global(.profesionales__marco[data-portada='video'] .profesionales__foto img) {
    object-fit: contain;
  }

  /*
   * La fachada cubre el tile entero: mismo área de clic que el `<a>` del
   * prototipo, pero como botón real. Sin fondo ni borde propios, para que la
   * caja quede idéntica a la del diseño.
   */
  .profesionales__fachada {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    display: block;
  }

  /* Anillo de foco on-dark (tokens.css §--color-border-focus: "on-dark:
     brand-300"), hacia adentro porque el marco recorta lo que se sale. */
  .profesionales__fachada:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-brand-300);
    outline-offset: calc(-1 * (var(--focus-ring-width) + var(--focus-ring-offset)));
  }

  /* Reproductor: ocupa el tile completo una vez que el visitante pulsa. */
  .profesionales :global(.profesionales__reproductor) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: var(--color-neutral-800);
  }

  .profesionales :global(.profesionales__foto.imagen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .profesionales__velo {
    position: absolute;
    inset: 0;
    background: var(--scrim-base);
  }

  /* Botón de play del prototipo: cuadrado de 72px con hairline on-dark. */
  .profesionales__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width) solid var(--color-border-on-dark-strong);
    color: var(--color-text-on-dark);
  }

  .profesionales__videoetiqueta {
    position: absolute;
    left: clamp(20px, 3vw, 40px);
    right: clamp(20px, 3vw, 40px);
    bottom: clamp(20px, 3vw, 40px);
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .profesionales :global(.profesionales__texto) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(20px, 2.2vw, 28px);
    padding: clamp(32px, 5vw, 80px);
    min-width: 0;
  }

  .profesionales__eyebrow {
    margin: 0;
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .profesionales__numero {
    color: var(--color-brand-700);
  }

  .profesionales__titulo {
    margin: 0;
    max-width: 20ch;
    font: 300 clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem) / 1.12 var(--font-heading);
    color: var(--color-text-primary);
  }

  .profesionales__bajada {
    margin: 0;
    max-width: 44ch;
    font: var(--text-body-15);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* Bloque de redes: rótulo + botones outline, gaps 14/12 del prototipo. */
  .profesionales__redes {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .profesionales__redes-rotulo {
    margin: 0;
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .profesionales__redes-lista {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .profesionales__red {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--control-height-md);
    padding-inline: var(--space-5);
    border: var(--border-width) solid var(--color-action-secondary-border);
    color: var(--color-action-secondary-text);
    background: transparent;
    text-decoration: none;
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-md);
    text-transform: uppercase;
    transition:
      background-color var(--dur-respuesta) var(--ease-respuesta),
      color var(--dur-respuesta) var(--ease-respuesta);
  }

  .profesionales__red:hover {
    background: var(--color-brand-700);
    color: var(--color-neutral-0);
  }

  @media (min-width: 760px) {
    .profesionales__grid {
      grid-template-columns: 1fr 1fr;
    }

    .profesionales__grid--sin-imagen {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  /**
   * Fachada de video: hasta que alguien pulsa, en la página no hay ni un byte
   * de terceros. Al pulsar se crea el reproductor dentro del mismo marco.
   *
   *   tipo "youtube" → iframe de youtube-nocookie.com (dominio sin cookies de
   *                    seguimiento previo), con autoplay para que el clic que
   *                    abrió el reproductor sea también el que lo arranca.
   *   tipo "archivo" → <video> local con controles: nunca sale del sitio.
   *
   * Se delega en el documento y se vuelve a enganchar en `astro:page-load`
   * porque con View Transitions el marcado se reemplaza sin recargar.
   */
  const abrir = (boton: HTMLElement) => {
    const marco = boton.closest<HTMLElement>('.profesionales__marco')
    if (!marco) return
    const titulo = boton.dataset.videoTitulo || 'Video'
    let reproductor: HTMLElement

    if (boton.dataset.videoTipo === 'youtube') {
      const id = boton.dataset.videoId
      if (!id) return
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&modestbranding=1&playsinline=1`
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen'
      iframe.allowFullscreen = true
      iframe.referrerPolicy = 'strict-origin-when-cross-origin'
      reproductor = iframe
    } else {
      const url = boton.dataset.videoUrl
      if (!url) return
      const video = document.createElement('video')
      video.src = url
      video.controls = true
      video.autoplay = true
      video.playsInline = true
      reproductor = video
    }

    reproductor.className = 'profesionales__reproductor'
    reproductor.title = titulo
    marco.querySelector('.profesionales__foto')?.remove()
    boton.remove()
    marco.append(reproductor)
    reproductor.focus?.()
  }

  const enganchar = () => {
    const marco = document.querySelector('.profesionales__marco')
    if (!marco || marco.hasAttribute('data-fachada-lista')) return
    marco.setAttribute('data-fachada-lista', '')
    marco.addEventListener('click', (evento) => {
      const boton = (evento.target as HTMLElement | null)?.closest<HTMLElement>('.profesionales__fachada')
      if (boton) abrir(boton)
    })
  }

  enganchar()
  document.addEventListener('astro:page-load', enganchar)
</script>
