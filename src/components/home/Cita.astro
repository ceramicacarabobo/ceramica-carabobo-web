---
/**
 * Respiro editorial entre "Ambientes" y "Proyectos": una línea destacada,
 * centrada, sin más ornamento (los filetes que tuvo en diseño salieron del
 * markup el 24/08 — ver `design/NOTAS-SESION-DISENO.md`).
 *
 * Contenido defensivo: sin texto, la sección no existe.
 */
import Reveal from '~/components/base/Reveal.astro'
import Seccion from '~/components/base/Seccion.astro'

interface Props {
  cita?: string
}

const {cita} = Astro.props

// El campo es un textarea de 2 filas (modelo-de-contenido.md): el salto de
// línea que escribe el editor viaja como "\n" literal en el string. HTML
// colapsa esa "\n" a un espacio, así que sin esto el navegador reenvuelve el
// texto a su propio criterio en vez del corte editorial de 2 líneas — el
// mismo que el prototipo fija con un <br> a mano. Medido: el ancho de la caja
// del texto cambiaba (537px en el prototipo vs 780px acá) y el diff de
// píxeles subía a 1,66% en la sección completa.
const lineas = cita?.split('\n') ?? []
---

{
  cita && (
    <Seccion como="section" id="cita" aria-label={cita}>
      <Reveal como="div">
        {/* La clase de layout va en este div, no en la del Reveal: el elemento
            raíz de Reveal pertenece a Reveal.astro y su propio scope de CSS,
            así que una clase de este archivo puesta ahí nunca calzaría con
            esta hoja de estilos (mismo caso que Ambientes.astro). */}
        <div class="cita">
          <p class="cita__texto">
            {lineas.map((linea, indice) => (
              <>
                {indice > 0 && <br />}
                {linea}
              </>
            ))}
          </p>
        </div>
      </Reveal>
    </Seccion>
  )
}

<style>
  /* El id gana por especificidad al `.seccion` de Seccion.astro (que este
     archivo no puede tocar): el prototipo usa un ritmo más angosto acá —
     clamp(64px,7vw,96px) — que el --space-section genérico
     (clamp(72px,8vw,120px)); a 1440px son 96px contra 115,2px. */
  #cita {
    padding-top: clamp(64px, 7vw, 96px);
  }

  .cita {
    max-width: min(100%, 780px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cita__texto {
    margin: 0;
    font: 300 clamp(1.875rem, 1.4rem + 2.1vw, 3.25rem) / 1.15 var(--font-heading);
    letter-spacing: var(--tracking-display-light);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }
</style>
