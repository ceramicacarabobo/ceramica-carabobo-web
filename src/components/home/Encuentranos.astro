---
/**
 * Sección "04 · Encuéntranos" de la home: índice de estados + panel con el
 * total de la red, tomado de `design/publicar/index.html` (constantes
 * REGIONES/RED, método `filaEnc` y las claves `enc*` de `renderVals()`).
 *
 * Los conteos NUNCA se escriben a mano (regla del encargo): se derivan acá
 * mismo de `distribuidores` con `contarPorEstado()` (`src/lib/data/index.ts`)
 * para el índice por estado, y con `Set` sobre `ciudad` para el total de
 * ciudades — el mismo criterio que documenta el prototipo ("24 puntos, 20
 * estados, 23 ciudades: los dos de Caracas comparten ciudad").
 *
 * Hover-only → tap: en el prototipo, pasar el cursor por una fila del índice
 * "posa" el panel en ese estado y salir del índice lo devuelve al agregado
 * (`salirEnc`/`posarEnc`). Acá cada fila es un <button>: click/Enter/Espacio
 * hacen exactamente lo mismo que el hover (por eso el listener de mouseenter
 * sólo corre bajo `(hover: hover)`), así que nada del panel es exclusivo del
 * mouse. El foco por teclado también posa el panel, para no dejar ese estado
 * inalcanzable sin mouse ni tap.
 *
 * Reflow: el índice+panel pasan de una columna a dos (`encCols` del
 * prototipo) en el mismo breakpoint móvil de 760px que usan Proyectos y
 * Profesionales.
 *
 * El índice NO es la red completa: el prototipo lista seis estados y remata con
 * el CTA a Dónde comprar, que sí los trae todos. Cuáles son esos seis no se
 * deriva de los conteos (el prototipo deja fuera a Miranda, que empata en
 * puntos con los tres primeros): es una decisión editorial y por eso vive en el
 * CMS, en `encuentranos.estadosDestacados`. Los NÚMEROS siguen derivándose.
 *
 * El panel del prototipo se corona con una foto de ambiente
 * (`encuentranos.foto`), sobre la caja de datos.
 *
 * Contenido defensivo: sin etiqueta/título/texto y sin distribuidores no hay
 * nada que mostrar y la sección desaparece. Con textos pero sin distribuidores
 * (regla del encargo), se muestra solo el encabezado — ningún número
 * inventado. Sin foto, el panel se compone igual: la caja de datos tiene alto
 * mínimo propio (212px, el del prototipo), así que no queda un hueco.
 */
import Boton from '~/components/base/Boton.astro'
import Imagen from '~/components/base/Imagen.astro'
import Reveal from '~/components/base/Reveal.astro'
import Seccion from '~/components/base/Seccion.astro'
import {contarPorEstado} from '~/lib/data'
import type {Distribuidor, Home} from '~/lib/data'

interface Props {
  encuentranos: Home['encuentranos']
  distribuidores: Distribuidor[]
}

const {encuentranos, distribuidores} = Astro.props

const hayTextos = Boolean(encuentranos.etiqueta || encuentranos.titulo || encuentranos.texto)
const hayRed = distribuidores.length > 0
const mostrarSeccion = hayTextos || hayRed

// Índice: la selección editorial del CMS (o toda la red, si está vacía).
const porEstado = contarPorEstado(distribuidores, encuentranos.estadosDestacados)

const ciudadesDeEstado = (estado: string) =>
  [...new Set(distribuidores.filter((d) => d.estado === estado).map((d) => d.ciudad))].join(' · ')

const filas = porEstado.map((f, indice) => ({
  numero: String(indice + 1).padStart(2, '0'),
  estado: f.estado,
  total: f.total,
  ciudades: ciudadesDeEstado(f.estado),
}))

// El panel resume la RED ENTERA, no la selección del índice: es el agregado
// nacional del prototipo ("24 distribuidores · 20 estados · 23 ciudades").
const totalPuntos = distribuidores.length
const totalEstados = new Set(distribuidores.map((d) => d.estado)).size
const totalCiudades = new Set(distribuidores.map((d) => d.ciudad)).size

// "Red nacional" es un rótulo de UI (como "Estado" o "Ciudad" en las fichas),
// no texto de marca: aparece solo cuando ningún estado está seleccionado.
const panelEtiquetaBase = 'Red nacional'
const panelTituloBase = encuentranos.titulo || panelEtiquetaBase
const panelDatoBase = String(totalPuntos).padStart(2, '0')
const panelUnidadBase = 'distribuidores'
const panelCiudadesBase = `${totalEstados} ${totalEstados === 1 ? 'estado' : 'estados'} · ${totalCiudades} ${totalCiudades === 1 ? 'ciudad' : 'ciudades'}`
const panelCtaBase = 'Dónde comprar'
---

{
  mostrarSeccion && (
    <Seccion cierre
      como="section"
      id="donde-comprar"
      class="encuentranos"
      fondo="base"
      aria-labelledby={encuentranos.titulo ? 'encuentranos-titulo' : undefined}
    >
      <Reveal como="div" class="encuentranos__cabecera">
        {encuentranos.etiqueta && (
          <p class="encuentranos__eyebrow">
            <span class="encuentranos__numero">05</span> · {encuentranos.etiqueta}
          </p>
        )}
        {encuentranos.titulo && (
          <h2 id="encuentranos-titulo" class="encuentranos__titulo">
            {encuentranos.titulo}
          </h2>
        )}
        {encuentranos.texto && <p class="encuentranos__bajada">{encuentranos.texto}</p>}
      </Reveal>

      {hayRed && (
        <div class="encuentranos__grid" data-encuentranos>
          <ul class="encuentranos__indice" data-indice>
            {filas.map((fila) => (
              <li>
                <button
                  type="button"
                  class="fila"
                  data-fila
                  aria-pressed="false"
                  data-estado={fila.estado}
                  data-total={fila.total}
                  data-ciudades={fila.ciudades}
                >
                  <span class="fila__num" aria-hidden="true">
                    {fila.numero}
                  </span>
                  <span class="fila__nombre">{fila.estado}</span>
                  <span class="fila__valor">
                    {fila.total} {fila.total === 1 ? 'punto' : 'puntos'}
                  </span>
                </button>
              </li>
            ))}
          </ul>

          {/* Contenido repetido: entra ya visible y conserva solo la máscara.
              El envoltorio que traía el `Reveal` no tenía estilos propios. */}
          <div class="panel" data-mascara>
            {encuentranos.foto && (
              <Imagen
                imagen={encuentranos.foto}
                class="panel__foto"
                sizes="(min-width: 760px) 45vw, 100vw"
                ancho={1200}
              />
            )}
            <div class="panel__cuerpo" data-panel aria-live="polite">
              <p class="panel__etiqueta" data-panel-etiqueta>
                {panelEtiquetaBase}
              </p>
              <p class="panel__titulo" data-panel-titulo>
                {panelTituloBase}
              </p>
              <div class="panel__dato">
                <span class="panel__numero" data-panel-dato>
                  {panelDatoBase}
                </span>
                <span class="panel__unidad" data-panel-unidad>
                  {panelUnidadBase}
                </span>
              </div>
              <p class="panel__ciudades" data-panel-ciudades>
                {panelCiudadesBase}
              </p>
              <Boton href="/donde-comprar" class="panel__cta">
                <span data-panel-cta>{panelCtaBase}</span>
              </Boton>
            </div>
          </div>
        </div>
      )}
    </Seccion>
  )
}

<style>
  .encuentranos__cabecera {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.6vw, 18px);
    max-width: 44ch;
    /* Seccion centra con `margin-inline: auto` a todo hijo directo (para
       bloques a ancho completo no se nota, pero acá el bloque es angosto
       —44ch— y quedaba centrado en vez de pegado al gutter, como el
       prototipo). */
    margin-inline: 0;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .encuentranos__eyebrow {
    margin: 0;
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .encuentranos__numero {
    color: var(--color-brand-700);
  }

  .encuentranos__titulo {
    margin: 0;
    font: var(--text-display);
    color: var(--color-text-primary);
  }

  .encuentranos__bajada {
    margin: 0;
    font: var(--text-body-15);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .encuentranos__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: clamp(32px, 4.5vw, 64px);
  }

  .encuentranos__indice {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .fila {
    display: grid;
    grid-template-columns: 38px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    width: 100%;
    padding: 16px 0 16px 12px;
    background: transparent;
    border: 0;
    border-top: var(--border-width) solid var(--color-surface-sunken);
    border-left: 2px solid transparent;
    cursor: pointer;
    text-align: left;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  li:first-child .fila {
    border-top-color: var(--color-border-hairline);
  }

  .fila:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-border-focus);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  @media (hover: hover) {
    .fila:hover {
      transform: translateX(12px);
    }
  }

  .fila[aria-pressed='true'] {
    background: var(--color-surface-sunken);
    border-left-color: var(--color-brand-700);
  }

  .fila__num {
    font: 400 0.75rem/normal var(--font-heading);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .fila[aria-pressed='true'] .fila__num {
    color: var(--color-brand-700);
  }

  .fila__nombre {
    font: var(--text-title-md);
    color: var(--color-text-primary);
    min-width: 0;
  }

  .fila__valor {
    font: var(--text-caption-lg);
    white-space: nowrap;
    color: var(--color-text-secondary);
  }

  .fila[aria-pressed='true'] .fila__valor {
    color: var(--color-brand-700);
  }

  .panel {
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-hairline);
  }

  /* Alto fijo, como en el prototipo: la foto corona el panel y la caja de
     datos queda debajo. El wrapper de imagen reserva proporción, que acá
     estorba (el recorte manda), así que se apaga el aspect-ratio. */
  .encuentranos :global(.panel__foto.imagen) {
    aspect-ratio: auto;
    height: clamp(400px, 50vh, 600px);
  }

  .panel__cuerpo {
    /* 212px es el mínimo del prototipo: sostiene la caja aunque no haya foto
       y evita que el bloque de datos salte al cambiar de estado. */
    min-height: 212px;
    box-sizing: border-box;
    padding: clamp(24px, 2.6vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .panel__etiqueta {
    margin: 0;
    /* 0.6875rem/0.18em: el prototipo usa una variante más chica y apretada
       que el overline de sección (--text-overline es 0.75rem/0.16em), sin
       token que la represente. */
    font: 500 0.6875rem/normal var(--font-heading);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .panel__titulo {
    margin: 0;
    font: 300 clamp(1.625rem, 1.4rem + 0.9vw, 2rem) / 1.04 var(--font-heading);
    color: var(--color-text-primary);
  }

  .panel__dato {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .panel__numero {
    font: 300 clamp(2rem, 1.7rem + 1.2vw, 2.5rem) / 0.9 var(--font-heading);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-primary);
  }

  .panel__unidad {
    font: 400 0.75rem/normal var(--font-heading);
    letter-spacing: var(--tracking-uppercase-md);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .panel__ciudades {
    margin: 0;
    /* Mismo tamaño chico que panel__etiqueta (0.6875rem); acá sí coincide con
       tracking-uppercase-lg (0.16em). */
    font: 500 0.6875rem/normal var(--font-heading);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  /*
   * `:global` porque el destino es el <a> que dibuja `Boton`, y ese elemento
   * no lleva el scope de esta sección: sin esto la regla no hacía match y el
   * botón se estiraba a lo ancho del panel (mismo modo de falla que el
   * hallazgo 2 de docs/fase-2-qa-fidelidad.md).
   */
  .encuentranos :global(.panel__cta) {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (min-width: 760px) {
    .encuentranos__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }

    /* En el prototipo el sticky va en el ÍNDICE (la lista de estados es la
       más larga de las dos columnas), no en el panel: al bajar por la lista
       el panel queda libre de desplazarse con la página. */
    .encuentranos__indice {
      position: sticky;
      /* 63px es el alto documentado de la banda compacta del header fijo
         (`docs/fase-2-qa-fidelidad.md`); esta sección no importa ese valor
         de `Header.astro` para no acoplarse, así que replica la constante
         del prototipo (`Math.max(63, bandH) + 16`) en vez del token de
         espaciado que había antes. */
      top: calc(63px + var(--space-4));
    }

    .fila {
      grid-template-columns: 44px 1fr auto;
      padding: clamp(18px, 2.2vw, 26px) 0 clamp(18px, 2.2vw, 26px) 14px;
    }
  }
</style>

<script>
  function iniciarEncuentranos() {
    const raiz = document.querySelector<HTMLElement>('[data-encuentranos]')
    if (!raiz) return

    const lista = raiz.querySelector<HTMLElement>('[data-indice]')
    const filas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-fila]')]
    const panel = raiz.querySelector<HTMLElement>('[data-panel]')
    if (!lista || !panel || filas.length === 0) return

    const etiquetaEl = panel.querySelector<HTMLElement>('[data-panel-etiqueta]')
    const tituloEl = panel.querySelector<HTMLElement>('[data-panel-titulo]')
    const datoEl = panel.querySelector<HTMLElement>('[data-panel-dato]')
    const unidadEl = panel.querySelector<HTMLElement>('[data-panel-unidad]')
    const ciudadesEl = panel.querySelector<HTMLElement>('[data-panel-ciudades]')
    const ctaEl = panel.querySelector<HTMLElement>('[data-panel-cta]')
    if (!etiquetaEl || !tituloEl || !datoEl || !unidadEl || !ciudadesEl || !ctaEl) return

    // Estado base = agregado nacional, leído del primer render (SSR) para no
    // duplicar los totales ya calculados en el frontmatter.
    const base = {
      etiqueta: etiquetaEl.textContent ?? '',
      titulo: tituloEl.textContent ?? '',
      dato: datoEl.textContent ?? '',
      unidad: unidadEl.textContent ?? '',
      ciudades: ciudadesEl.textContent ?? '',
      cta: ctaEl.textContent ?? '',
    }

    const mostrar = (fila: HTMLButtonElement | null) => {
      filas.forEach((f) => f.setAttribute('aria-pressed', String(f === fila)))
      if (fila) {
        const total = Number(fila.dataset.total ?? 0)
        etiquetaEl.textContent = 'Estado'
        tituloEl.textContent = fila.dataset.estado ?? ''
        datoEl.textContent = String(total).padStart(2, '0')
        unidadEl.textContent = total === 1 ? 'punto de venta' : 'puntos de venta'
        ciudadesEl.textContent = fila.dataset.ciudades ?? ''
        ctaEl.textContent = 'Ver distribuidores'
      } else {
        etiquetaEl.textContent = base.etiqueta
        tituloEl.textContent = base.titulo
        datoEl.textContent = base.dato
        unidadEl.textContent = base.unidad
        ciudadesEl.textContent = base.ciudades
        ctaEl.textContent = base.cta
      }
    }

    filas.forEach((fila) => {
      const activar = () => mostrar(fila)
      fila.addEventListener('click', activar)
      fila.addEventListener('focus', activar)
      // El hover solo posa en desktop: en táctil el único gesto es el tap,
      // que ya dispara 'click'.
      fila.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) activar()
      })
    })

    lista.addEventListener('mouseleave', () => {
      if (window.matchMedia('(hover: hover)').matches) mostrar(null)
    })
  }

  iniciarEncuentranos()
  document.addEventListener('astro:page-load', iniciarEncuentranos)
</script>
