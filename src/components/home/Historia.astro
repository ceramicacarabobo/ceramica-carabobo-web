---
/**
 * 03 · Historia — índice con riel de miniaturas
 * (`design/handoff-p1-v2/README.md` §03).
 *
 * REEMPLAZA al hilo conducido por scroll (100vh + 5×40vh) del archivo anterior.
 * Decisión del cliente del 2026-09-04: el hito cambia al pasar el cursor y al
 * enfocar, sin necesidad de clic, y NO hay auto-avance. Con eso la sección deja
 * de ser la excepción de movimiento del sitio: ya nada fija el scroll.
 *
 * Las cinco fotos viven apiladas en el mismo marco y se relevan con el FUNDIDO
 * APILADO del hero: la saliente se queda opaca debajo y sin transición, y solo
 * la entrante sube 0→1 en 1200ms. Un fundido cruzado deja las dos capas
 * translúcidas a la vez y el navegador promedia las luminancias — el punto
 * medio sale gris.
 *
 * Las capas van por `background-image` y no por `<img>`: el marcador de carga
 * (`base/Imagen.astro`, que arranca las fotos en opacidad 0) pelearía con la
 * opacidad del fundido. Las miniaturas sí son `<img>` y lo conservan.
 *
 * El atenuado de las miniaturas inactivas se hace con un VELO encima, no
 * bajando la opacidad del `<img>`, por lo mismo.
 *
 * Contenido defensivo: con menos de 3 hitos no hay hilo que contar y la sección
 * entera no se muestra. Un hito sin foto deja su capa vacía sobre la superficie
 * neutra del marco, sin romper el riel.
 */
import {getImage} from 'astro:assets'
import Seccion from '~/components/base/Seccion.astro'
import Reveal from '~/components/base/Reveal.astro'
import Imagen from '~/components/base/Imagen.astro'
import type {Home} from '~/lib/data'
import {urlOrigen} from '~/lib/imagenes'

interface Props {
  historia: Home['historia']
}

const {historia} = Astro.props

// Orden cronológico: el riel solo se lee si los años suben.
const hitos = [...historia.hitos].sort((a, b) => a.anio - b.anio)
const hayHilo = hitos.length >= 3

// Las capas del marco son fondos, así que la URL procesada se pide a mano.
// 1600px cubre el marco a ancho completo en pantallas grandes.
const capas = await Promise.all(
  hitos.map(async (hito) =>
    hito.imagen
      ? (await getImage({src: urlOrigen(hito.imagen, 1600), width: 1600, height: 900, format: 'webp', quality: 78})).src
      : null,
  ),
)
---

{
  hayHilo && (
    <Seccion
      como="section"
      id="historia"
      class="historia"
      fondo="base"
      style="--space-section: clamp(40px, 4.5vw, 64px)"
      aria-labelledby={historia.titulo ? 'historia-titulo' : undefined}
    >
      <Reveal como="div" class="historia__cabecera">
        {historia.etiqueta && (
          <p class="historia__eyebrow">
            <span class="historia__numero">03</span> · {historia.etiqueta}
          </p>
        )}
        {historia.titulo && (
          <h2 id="historia-titulo" class="historia__titulo">
            {historia.titulo}
          </h2>
        )}
      </Reveal>

      <div class="historia__grid">
        {/* Contenido repetido: entra ya visible y conserva solo la máscara. */}
        <div class="historia__marco" data-mascara data-marco>
          {capas.map((fondo, indice) => (
            <span
              class="historia__capa"
              aria-hidden="true"
              data-capa={indice}
              data-activa={indice === 0 ? '' : undefined}
              style={fondo ? `background-image: url('${fondo}')` : undefined}
            />
          ))}
        </div>

        <div class="historia__datos" aria-live="polite">
          <p class="historia__anio" data-anio>
            {hitos[0].anio}
          </p>
          <h3 class="historia__hito" data-titulo>
            {hitos[0].titulo}
          </h3>
          {hitos.some((hito) => hito.texto) && (
            <p class="historia__texto" data-texto>
              {hitos[0].texto}
            </p>
          )}
        </div>
      </div>

      <div class="historia__riel">
        {hitos.map((hito, indice) => (
          <button
            type="button"
            class="mini"
            data-mini={indice}
            aria-current={indice === 0 ? 'true' : 'false'}
            aria-label={`${hito.anio} · ${hito.titulo}`}
            data-hito-anio={hito.anio}
            data-hito-titulo={hito.titulo}
            data-hito-texto={hito.texto ?? ''}
          >
            <span class="mini__marco">
              <Imagen imagen={hito.imagen} ratio="3 / 2" sizes="(min-width: 760px) 18vw, 32vw" ancho={600} class="mini__foto" />
              <span class="mini__velo" aria-hidden="true" />
            </span>
            <span class="mini__anio">{hito.anio}</span>
            <span class="mini__filete" aria-hidden="true" />
          </button>
        ))}
      </div>
    </Seccion>
  )
}

<style>
  /* El aire de esta sección va desbalanceado a propósito: la banda a sangre de
     arriba ya puso el ritmo completo, así que acá el superior baja a la mitad
     (handoff §Banda obra). Se hace redefiniendo el token en el propio elemento
     —va en el markup— y no con una regla: el `<section>` lo produce `Seccion`,
     así que no lleva el scope de este archivo y una regla de acá no lo alcanza. */
  .historia__cabecera {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
    margin-bottom: clamp(28px, 3vw, 44px);
  }

  .historia__eyebrow {
    font: var(--text-overline);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .historia__numero {
    color: var(--color-brand-700);
  }

  .historia__titulo {
    font: var(--text-display);
    color: var(--color-text-primary);
  }

  .historia__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 48px);
    align-items: stretch;
  }

  .historia__marco {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-sunken);
    aspect-ratio: 16 / 9;
  }

  /* Fundido APILADO, la misma receta del carrusel del hero: la capa que sale se
     queda opaca DEBAJO y sin transición; solo la entrante sube. */
  .historia__capa {
    position: absolute;
    inset: 0;
    display: block;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    opacity: 0;
    z-index: 0;
  }

  .historia__capa[data-previa] {
    opacity: 1;
    z-index: 1;
  }

  .historia__capa[data-activa] {
    opacity: 1;
    z-index: 2;
    transition: opacity var(--dur-hero-fundido) var(--ease-editorial);
  }

  .historia__datos {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 14px;
    padding-bottom: 8px;
  }

  .historia__anio {
    font: 300 clamp(2.5rem, 1.9rem + 2.4vw, 4rem) / 1 var(--font-heading);
    color: var(--color-brand-700);
    font-variant-numeric: tabular-nums;
  }

  .historia__hito {
    font: 300 clamp(1.5rem, 1.3rem + 0.9vw, 2rem) / 1.14 var(--font-heading);
    color: var(--color-text-primary);
  }

  .historia__texto {
    max-width: 38ch;
    font: var(--text-body-15);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  /* ── El riel ─────────────────────────────────────────────────────────────
     Tres columnas en móvil, cinco desde 760. */
  .historia__riel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .mini {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: none;
    border: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .mini__marco {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-surface-sunken);
  }

  .mini :global(.mini__foto) {
    width: 100%;
    height: 100%;
  }

  /* Velo, no opacidad del <img>: bajarle la opacidad a la foto pelearía con el
     marcador de carga, que también escribe opacidad. */
  .mini__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: rgba(245, 243, 240, 0.42);
    transition: background var(--dur-respuesta) var(--ease-respuesta);
  }

  .mini[aria-current='true'] .mini__velo {
    background: rgba(245, 243, 240, 0);
  }

  .mini__anio {
    font: 500 0.8125rem/normal var(--font-heading);
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    transition: color var(--dur-respuesta) var(--ease-respuesta);
  }

  .mini[aria-current='true'] .mini__anio {
    color: var(--color-text-primary);
  }

  /* El filete activo va en su propio elemento y no como `border-bottom` de la
     miniatura: así el micro-estado de 180ms no comparte declaración con nada. */
  .mini__filete {
    display: block;
    height: 2px;
    flex: none;
    background: transparent;
    transition: background var(--dur-respuesta) var(--ease-respuesta);
  }

  .mini[aria-current='true'] .mini__filete {
    background: var(--color-brand-700);
  }

  @media (min-width: 760px) {
    .historia__grid {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
    }

    .historia__riel {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>

<script>
  /**
   * Relevo de hito. Cambia con el cursor encima y con el foco —sin clic—, y el
   * clic y Enter/Espacio hacen lo mismo por táctil y teclado. No hay
   * auto-avance: es decisión del cliente, no un olvido.
   */
  function iniciarHistoria() {
    const seccion = document.querySelector<HTMLElement>('.historia')
    if (!seccion) return

    const capas = [...seccion.querySelectorAll<HTMLElement>('[data-capa]')]
    const minis = [...seccion.querySelectorAll<HTMLButtonElement>('[data-mini]')]
    const anio = seccion.querySelector<HTMLElement>('[data-anio]')
    const titulo = seccion.querySelector<HTMLElement>('[data-titulo]')
    const texto = seccion.querySelector<HTMLElement>('[data-texto]')
    if (capas.length === 0 || minis.length === 0) return

    let activa = 0
    const ver = (indice: number) => {
      if (indice === activa) return
      const anterior = activa
      activa = indice

      capas.forEach((capa, i) => {
        capa.toggleAttribute('data-activa', i === indice)
        // Apilado: la que se va queda opaca debajo hasta el próximo relevo.
        capa.toggleAttribute('data-previa', i !== indice && i === anterior)
      })

      minis.forEach((mini, i) => mini.setAttribute('aria-current', i === indice ? 'true' : 'false'))

      const mini = minis[indice]
      if (anio) anio.textContent = mini.dataset.hitoAnio ?? ''
      if (titulo) titulo.textContent = mini.dataset.hitoTitulo ?? ''
      if (texto) texto.textContent = mini.dataset.hitoTexto ?? ''
    }

    minis.forEach((mini, indice) => {
      mini.addEventListener('click', () => ver(indice))
      mini.addEventListener('focus', () => ver(indice))
      // El hover solo manda donde hay puntero: en táctil el tap es el gesto.
      mini.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) ver(indice)
      })
    })
  }

  iniciarHistoria()
  document.addEventListener('astro:page-load', iniciarHistoria)
</script>
