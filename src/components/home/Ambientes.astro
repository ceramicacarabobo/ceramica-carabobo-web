---
/**
 * Sección "01 · Ambientes" de la home: pestañas por espacio (Baños, Salas…)
 * con un track de fichas por pestaña.
 *
 * Reflow (`Responsividad v0` §03, fila "Track de ambientes"): desktop/tablet
 * usa pestañas + flechas y tarjetas de 280–440px, sin autoavance; móvil usa
 * pestañas scrolleables horizontalmente + track por swipe con scroll-snap,
 * tarjetas al 78vw, y las flechas se ocultan porque el gesto las reemplaza.
 * El corte entre ambos modos es el breakpoint móvil (760px) — decidido por
 * CSS, nunca por JS.
 *
 * Contenido defensivo: una ficha sin foto no tiene nada que mostrar; una
 * pestaña con menos de 3 fichas útiles no se muestra (modelo-de-contenido.md
 * §Home: "mínimo 3 fichas por pestaña"); si no queda ninguna pestaña, la
 * sección entera desaparece.
 */
import Imagen from '~/components/base/Imagen.astro'
import Reveal from '~/components/base/Reveal.astro'
import Seccion from '~/components/base/Seccion.astro'
import type {Home} from '~/lib/data'

interface Props {
  ambientes: Home['ambientes']
}

const {ambientes} = Astro.props

const pestanas = ambientes.pestanas
  .map((pestana) => ({...pestana, fichas: pestana.fichas.filter((ficha) => ficha.foto)}))
  .filter((pestana) => pestana.label && pestana.fichas.length >= 3)
---

{
  pestanas.length > 0 && (
    <Seccion como="section" id="ambientes" class="ambientes" sangrado aria-labelledby={ambientes.titulo ? 'ambientes-titulo' : undefined}>
      <Reveal como="div">
        {/* El gutter y el layout de la cabecera van en este div, no en la clase
            del Reveal: Astro aplica el scope de CSS del componente que define
            el elemento, y el elemento raíz de Reveal pertenece a Reveal.astro,
            no a este archivo — una clase puesta ahí nunca calzaría con esta
            hoja de estilos. */}
        <div class="ambientes__cabecera">
          <div class="ambientes__intro">
            {ambientes.etiqueta && (
              <p class="ambientes__eyebrow">
                <span class="ambientes__numero">01</span> · {ambientes.etiqueta}
              </p>
            )}
            {ambientes.titulo && (
              <h2 id="ambientes-titulo" class="ambientes__titulo">
                {ambientes.titulo}
              </h2>
            )}
            <div class="ambientes__tabs" role="tablist" aria-orientation="horizontal" aria-label={ambientes.etiqueta || ambientes.titulo || 'Ambientes'}>
              {pestanas.map((pestana, indice) => (
                <button
                  type="button"
                  role="tab"
                  id={`ambientes-tab-${indice}`}
                  aria-controls={`ambientes-panel-${indice}`}
                  aria-selected={indice === 0 ? 'true' : 'false'}
                  tabindex={indice === 0 ? 0 : -1}
                  class="ambientes__tab"
                  data-amb-tab
                >
                  {pestana.label}
                </button>
              ))}
            </div>
          </div>

          <div class="ambientes__flechas">
            <button type="button" class="ambientes__flecha" aria-label="Anterior" data-amb-prev>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m12 19-7-7 7-7" />
              </svg>
            </button>
            <button type="button" class="ambientes__flecha" aria-label="Siguiente" data-amb-next>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </Reveal>

      <Reveal como="div" indice={1}>
        <div class="ambientes__pistas">
          {pestanas.map((pestana, indice) => (
            <div
              class="ambientes__panel"
              id={`ambientes-panel-${indice}`}
              role="tabpanel"
              aria-labelledby={`ambientes-tab-${indice}`}
              hidden={indice !== 0}
              data-amb-panel
            >
              <div class="ambientes__track" data-amb-track>
                {pestana.fichas.map((ficha) => {
                  // El prototipo dibuja cada ficha como <a> al catálogo (tag `data-tile`).
                  // Sin producto enlazado (referencia rota o despublicada) no hay a dónde
                  // llevar: se deja como div, con los mismos datos, en vez de un enlace roto.
                  const Envoltura = ficha.slug ? 'a' : 'div'
                  const props = ficha.slug ? {href: `/catalogo/${ficha.slug}`} : {}
                  return (
                    <Envoltura class="ambientes__ficha" {...props}>
                      <Imagen imagen={ficha.foto} ratio="var(--ratio-portrait)" sizes="(min-width: 760px) 27vw, 78vw" class="ambientes__foto" />
                      <span class="ambientes__velo" aria-hidden="true" />
                      {(ficha.nombre || ficha.spec) && (
                        <span class="ambientes__datos">
                          {ficha.nombre && <span class="ambientes__nombre">{ficha.nombre}</span>}
                          {ficha.spec && <span class="ambientes__spec">{ficha.spec}</span>}
                        </span>
                      )}
                    </Envoltura>
                  )
                })}
              </div>
            </div>
          ))}
        </div>
      </Reveal>
    </Seccion>
  )
}

<style>
  .ambientes {
    overflow: hidden;
  }

  /* El selector de id gana por especificidad al `.seccion` de Seccion.astro
     (que este archivo no puede tocar): el prototipo usa un ritmo más angosto
     para esta sección — clamp(64px,7vw,104px) — que el --space-section
     genérico (clamp(72px,8vw,120px)). Medido: 14,4px de los ~37px de más
     salían de esta diferencia a 1440px. */
  #ambientes {
    padding-top: clamp(64px, 7vw, 104px);
  }

  .ambientes__cabecera {
    padding-inline: var(--space-gutter-page);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .ambientes__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
    min-width: 0;
  }

  .ambientes__eyebrow {
    margin: 0;
    font: var(--text-overline);
    /* El prototipo no fija line-height en este texto (usa el "normal" del
       navegador); el 1.35 del token --text-overline agrega ~2px de alto
       medidos contra el prototipo. Se corrige solo acá, sin tocar el token. */
    line-height: normal;
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ambientes__numero {
    color: var(--color-brand-700);
  }

  .ambientes__titulo {
    margin: 0;
    font: var(--text-display);
    color: var(--color-text-primary);
  }

  .ambientes__tabs {
    display: flex;
    gap: clamp(24px, 3vw, 44px);
    /* Área tocable de 44px sin mover la maqueta (checklist de aceptación nº11).
       La fila del diseño mide 24px y la zona ampliada vive en `.ambientes__tab::after`,
       pero en móvil `overflow-x: auto` obliga a `overflow-y: auto` y RECORTABA esa zona
       —medido con hit-test en `scripts/qa/aceptacion.mjs`—, así que el dedo solo
       alcanzaba 24px. La tira se alarga 10px arriba y abajo con padding y se descuenta
       con margen negativo: el alto que ocupa en el flujo es exactamente el de antes. */
    padding-block: 10px;
    margin-top: calc(clamp(8px, 1vw, 16px) - 10px);
    margin-bottom: -10px;
    /* Pestañas scrolleables horizontalmente (Responsividad v0 §03): en desktop
       no hace falta porque entran todas, en móvil reemplaza el wrap. */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ambientes__tabs::-webkit-scrollbar {
    display: none;
  }

  .ambientes__tab {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    padding-block: 4px;
    padding-inline: 0;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    /* line-height "normal" (no /1): el prototipo no fija line-height acá; con
       /1 la fila media ~21px contra los ~24px medidos en el prototipo. */
    font: 400 0.8125rem/normal var(--font-heading);
    letter-spacing: var(--tracking-uppercase-lg);
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition:
      color var(--dur-respuesta) var(--ease-respuesta),
      border-color var(--dur-respuesta) var(--ease-respuesta);
  }

  /* Área tocable mínima 44px sin inflar la fila: el prototipo mide ~24px de
     alto acá (min-height:44px en el botón agregaba 20px de más, medido). Se
     superpone una zona invisible más alta que el texto en vez de agrandar la
     caja real. */
  .ambientes__tab::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    transform: translateY(-50%);
    min-height: 44px;
  }

  .ambientes__tab:hover {
    color: var(--color-text-primary);
  }

  .ambientes__tab[aria-selected='true'] {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-action-primary);
  }

  .ambientes__tab:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-border-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .ambientes__flechas {
    display: none;
    gap: var(--space-2);
    flex: none;
  }

  .ambientes__flecha {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: var(--border-width) solid var(--color-border-default);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .ambientes__flecha:hover {
    border-color: var(--color-action-primary);
  }

  .ambientes__flecha:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-border-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .ambientes__pistas {
    margin-top: clamp(28px, 3.5vw, 48px);
  }

  .ambientes__panel {
    /* Móvil: el único desborde horizontal es este track, con scroll-snap. */
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .ambientes__track {
    display: flex;
    gap: clamp(12px, 1.5vw, 20px);
    padding-inline: var(--space-gutter-page);
    width: max-content;
    /* 480ms + ease-out: mismo par que el prototipo. No se reutiliza --dur-slow
       porque ese token queda reservado al hero (ver tokens.css). */
    transition: transform 480ms var(--ease-out);
  }

  .ambientes__ficha {
    position: relative;
    display: block;
    flex: none;
    scroll-snap-align: start;
    width: 78vw;
    background: var(--color-surface-sunken);
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ambientes__ficha:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-border-focus);
    outline-offset: calc(var(--focus-ring-offset) * -1);
  }

  .ambientes__foto {
    display: block;
  }

  .ambientes__velo {
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    pointer-events: none;
    background: linear-gradient(0deg, rgba(31, 31, 31, 0.62) 0%, rgba(31, 31, 31, 0) 100%);
  }

  .ambientes__datos {
    position: absolute;
    left: clamp(16px, 2vw, 28px);
    right: clamp(16px, 2vw, 28px);
    bottom: clamp(16px, 2vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ambientes__nombre {
    font: 300 clamp(1.375rem, 1.2rem + 0.7vw, 1.875rem) / 1.2 var(--font-heading);
    color: var(--color-text-on-dark);
  }

  .ambientes__spec {
    font: var(--text-caption-lg);
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 760px) {
    .ambientes__flechas {
      display: flex;
    }

    /* En desktop todas las pestañas entran sin desbordar (las flechas
       reemplazan el gesto de swipe): overflow-x:auto no hace falta y, sin
       querer, recorta la zona tocable ::after de arriba (overflow-x distinto
       de visible fuerza overflow-y a "auto" también, aunque no se declare). */
    .ambientes__tabs {
      overflow: visible;
    }

    .ambientes__panel {
      overflow: hidden;
      scroll-snap-type: none;
    }

    .ambientes__ficha {
      width: clamp(280px, 27vw, 440px);
    }
  }
</style>

<script>
  function iniciarAmbientes() {
    const seccion = document.querySelector<HTMLElement>('#ambientes')
    if (!seccion) return

    const tabs = [...seccion.querySelectorAll<HTMLButtonElement>('[data-amb-tab]')]
    const paneles = [...seccion.querySelectorAll<HTMLElement>('[data-amb-panel]')]
    const previo = seccion.querySelector<HTMLButtonElement>('[data-amb-prev]')
    const siguiente = seccion.querySelector<HTMLButtonElement>('[data-amb-next]')
    if (tabs.length === 0 || paneles.length === 0) return

    // Desplazamiento acumulado del track de cada panel (uno por pestaña).
    const desplazamientos = new WeakMap<HTMLElement, number>()

    const reiniciarTrack = (panel: HTMLElement) => {
      const track = panel.querySelector<HTMLElement>('[data-amb-track]')
      if (!track) return
      desplazamientos.set(track, 0)
      track.style.transform = 'none'
      track.scrollLeft = 0
    }

    let activo = 0

    const mostrar = (indice: number) => {
      activo = indice
      tabs.forEach((tab, i) => {
        const on = i === indice
        tab.setAttribute('aria-selected', on ? 'true' : 'false')
        tab.tabIndex = on ? 0 : -1
      })
      paneles.forEach((panel, i) => {
        panel.hidden = i !== indice
      })
      reiniciarTrack(paneles[indice])
    }

    tabs.forEach((tab, indice) => {
      tab.addEventListener('click', () => mostrar(indice))
      // Navegación por teclado del tablist: flechas, Home y End.
      tab.addEventListener('keydown', (evento) => {
        let destino = -1
        if (evento.key === 'ArrowRight') destino = (indice + 1) % tabs.length
        else if (evento.key === 'ArrowLeft') destino = (indice - 1 + tabs.length) % tabs.length
        else if (evento.key === 'Home') destino = 0
        else if (evento.key === 'End') destino = tabs.length - 1
        if (destino < 0) return
        evento.preventDefault()
        mostrar(destino)
        tabs[destino].focus()
      })
    })

    // Track de ambientes: sin auto-run, solo flechas. Transform puro.
    const mover = (direccion: number) => {
      const panel = paneles[activo]
      const track = panel?.querySelector<HTMLElement>('[data-amb-track]')
      const envoltura = track?.parentElement
      if (!track || !envoltura || track.children.length === 0) return
      const primera = track.children[0] as HTMLElement
      const estilo = getComputedStyle(track)
      const espacio = parseFloat(estilo.columnGap || estilo.gap || '0') || 0
      const paso = primera.getBoundingClientRect().width + espacio
      const max = Math.max(0, track.scrollWidth - envoltura.clientWidth)
      const actual = desplazamientos.get(track) ?? 0
      const proximo = Math.min(max, Math.max(0, actual + direccion * paso))
      desplazamientos.set(track, proximo)
      track.style.transform = 'translateX(' + -Math.round(proximo) + 'px)'
    }

    previo?.addEventListener('click', () => mover(-1))
    siguiente?.addEventListener('click', () => mover(1))

    mostrar(0)
  }

  iniciarAmbientes()
  document.addEventListener('astro:page-load', iniciarAmbientes)
</script>
