---
/**
 * Fundido de apertura: opacity 0→1 + translateY(--desplazamiento-entrada), una
 * sola vez. Solo opacity y transform (Tokens v0 §07).
 *
 * ALCANCE (`revealsAlcance: intermedio`, el valor con el que corre el prototipo):
 * se funden SOLO los cinco encabezados de apertura del home — Ambientes, Cita,
 * Proyectos, Profesionales y Encuéntranos. El contenido repetido (el track de
 * Ambientes, las filas de Proyectos, el tile de video, el panel de la red) entra
 * ya visible y conserva únicamente `data-mascara` y `data-filete`, que son los
 * dos efectos que no dependen de la opacidad y por eso siguen leyendo como
 * material y no como interfaz. Envolver una lista entera en un fundido es lo que
 * hacía que la página se sintiera una sola capa de movimiento.
 *
 * Valores MEDIDOS sobre el prototipo en marcha (que corre con su calibración
 * editorial activada): 660ms, curva simétrica `cubic-bezier(.37,0,.63,1)` y
 * desplazamiento de 10px. El umbral es cuando el elemento entró de verdad en
 * pantalla (top < 86% del alto de ventana) y la cascada, 60 + i×70ms.
 * La curva simétrica es deliberada: el ease-out fuerte queda para las respuestas
 * a una acción del usuario, no para las entradas de contenido.
 *
 * El observador de este componente es el ÚNICO del sitio: abre también las
 * máscaras y los filetes (`theme/base.css`), que viven en otros componentes.
 */
interface Props {
  /** Cualquier otro atributo (incluido el scope de estilos del padre) se reenvía. */
  [clave: string]: unknown
  /** Posición dentro del grupo, para la cascada. */
  indice?: number
  /** Paso de la cascada; 70ms en home, 60ms en páginas internas. */
  paso?: number
  como?: string
  class?: string
}

const {indice = 0, paso = 70, como = 'div', class: clase, ...resto} = Astro.props

// Etiqueta dinámica: Astro no puede tipar los atributos de un tag variable.
const Etiqueta = como as 'div'
---

<Etiqueta
  class:list={['reveal', clase]}
  data-reveal
  style={`--reveal-delay: ${indice === 0 ? 0 : 60 + indice * paso}ms`}
  {...resto}
>
  <slot />
</Etiqueta>

<style>
  /* Solo con la bandera de movimiento (`html[data-movimiento]`, la prende el head
     de `layouts/Base.astro`) el encabezado arranca invisible: sin JavaScript, o
     con movimiento reducido, nace en su sitio y no se anima nada. */
  :global(html[data-movimiento]) .reveal {
    opacity: 0;
    transform: translateY(var(--desplazamiento-entrada));
    transition:
      opacity var(--dur-aparicion) var(--ease-editorial) var(--reveal-delay, 0ms),
      transform var(--dur-aparicion) var(--ease-editorial) var(--reveal-delay, 0ms);
  }

  :global(html[data-movimiento]) .reveal[data-abierta] {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  /**
   * Observador único de las entradas del sitio. Abre las tres capas de
   * movimiento con el mismo atributo y el mismo umbral: el fundido de los
   * encabezados (`data-reveal`), la máscara de imagen (`data-mascara`) y el
   * filete que se dibuja (`data-filete`). Una sola vez por elemento.
   */
  const MARCAS = ['data-reveal', 'data-mascara', 'data-filete']
  const SIN_ABRIR = MARCAS.map((marca) => `[${marca}]:not([data-abierta])`).join(',')

  const activar = () => {
    const elementos = document.querySelectorAll<HTMLElement>(SIN_ABRIR)
    if (elementos.length === 0) return

    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reducido || !('IntersectionObserver' in window)) {
      elementos.forEach((el) => el.setAttribute('data-abierta', ''))
      return
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue
          entrada.target.setAttribute('data-abierta', '')
          observador.unobserve(entrada.target)
        }
      },
      {rootMargin: '0px 0px -14% 0px', threshold: 0},
    )

    elementos.forEach((el) => observador.observe(el))
  }

  activar()
  document.addEventListener('astro:page-load', activar)
</script>
