---
/**
 * Aparición al entrar en pantalla: opacity 0→1 + translateY(--reveal-offset),
 * una sola vez. Solo opacity y transform (Tokens v0 §07).
 *
 * Valores tomados del prototipo (`calibrarReveals` y `syncReveals`), que es la
 * referencia: duración 480ms con `--ease-out`, umbral cuando el elemento entró
 * de verdad en pantalla (top < 86% del alto de ventana) y cascada de 60 + i×70ms.
 * Con `prefers-reduced-motion` el contenido nace visible y no se anima nada.
 */
interface Props {
  /** Cualquier otro atributo (incluido el scope de estilos del padre) se reenvía. */
  [clave: string]: unknown
  /** Posición dentro del grupo, para la cascada. */
  indice?: number
  /** Paso de la cascada; 70ms en home, 60ms en páginas internas. */
  paso?: number
  como?: string
  class?: string
}

const {indice = 0, paso = 70, como = 'div', class: clase, ...resto} = Astro.props

// Etiqueta dinámica: Astro no puede tipar los atributos de un tag variable.
const Etiqueta = como as 'div'
---

<Etiqueta
  class:list={['reveal', clase]}
  data-reveal
  style={`--reveal-delay: ${indice === 0 ? 0 : 60 + indice * paso}ms`}
  {...resto}
>
  <slot />
</Etiqueta>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(var(--reveal-offset));
    transition:
      opacity var(--dur-slow) var(--ease-out) var(--reveal-delay, 0ms),
      transform var(--dur-slow) var(--ease-out) var(--reveal-delay, 0ms);
  }

  .reveal[data-visible] {
    opacity: 1;
    transform: none;
  }

  /* Sin JS (o con movimiento reducido) el contenido tiene que verse igual. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const activar = () => {
    const elementos = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-visible])')
    if (elementos.length === 0) return

    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reducido || !('IntersectionObserver' in window)) {
      elementos.forEach((el) => el.setAttribute('data-visible', ''))
      return
    }

    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue
          entrada.target.setAttribute('data-visible', '')
          observador.unobserve(entrada.target)
        }
      },
      {rootMargin: '0px 0px -14% 0px', threshold: 0},
    )

    elementos.forEach((el) => observador.observe(el))
  }

  activar()
  document.addEventListener('astro:page-load', activar)
</script>
