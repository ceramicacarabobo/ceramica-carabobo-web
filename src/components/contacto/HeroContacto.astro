---
/**
 * Hero de la página de Contacto: ruta, antetítulo, h1 y bajada sobre foto.
 *
 * Valores del prototipo (`design/publicar/contacto.html`, regla `.hero`): la
 * caja es más baja que la del catálogo —max(420px, 46dvh)— y el titular usa su
 * propia escala. Por eso este hero no reusa el del catálogo: son dos cajas
 * distintas del mismo patrón, no una con parámetros.
 *
 * Contenido defensivo: antetítulo, bajada y foto salen del CMS y, si no están,
 * no se dibujan. El h1 tiene respaldo en el nombre de la página en la
 * navegación: la página necesita exactamente un h1 (§6 del contrato, SEO).
 */
import Imagen from '~/components/base/Imagen.astro'
import type {Contacto} from '~/lib/data'

interface Props {
  hero: Contacto['hero']
  /** Nombre de la página en la navegación: respaldo del titular. */
  nombrePagina: string
}

const {hero, nombrePagina} = Astro.props
---

<section class="hero-con">
  {hero.imagen && <Imagen class="hero-con__foto" imagen={hero.imagen} prioridad sizes="100vw" />}
  <span class="hero-con__velo" aria-hidden="true"></span>

  <div class="hero-con__caja">
    <nav class="ruta" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span>{nombrePagina}</span>
    </nav>

    <div class="hero-con__fila">
      <div class="hero-con__texto">
        {hero.eyebrow && <p class="overline hero-con__eyebrow">{hero.eyebrow}</p>}
        <h1 class="hero-con__titular">{hero.titular || nombrePagina}</h1>
      </div>
      {hero.bajada && <p class="hero-con__bajada">{hero.bajada}</p>}
    </div>
  </div>
</section>

<style>
  .hero-con {
    position: relative;
    width: 100%;
    min-height: max(420px, 46dvh);
    overflow: hidden;
    background: var(--color-surface-inverse);
  }

  .hero-con :global(.hero-con__foto) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    height: 100%;
  }

  .hero-con__velo {
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
  }

  .hero-con__caja {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(16px, 2vw, 24px);
    min-height: max(420px, 46dvh);
    max-width: var(--size-content-max);
    margin-inline: auto;
    padding: clamp(96px, 11vw, 140px) var(--space-gutter-page) clamp(32px, 4vw, 56px);
  }

  .ruta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: 400 0.8125rem/1.5 var(--font-body);
    color: var(--color-text-on-dark);
  }

  .ruta a {
    color: var(--color-text-on-dark);
    border-bottom: var(--border-width) solid var(--color-border-on-dark);
  }

  .hero-con__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 48px);
  }

  .hero-con__texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 24ch;
  }

  .hero-con__eyebrow {
    color: var(--color-text-on-dark);
  }

  .hero-con__titular {
    font: 300 clamp(2.5rem, 1.7rem + 3.4vw, 4.75rem) / 1.06 var(--font-heading);
    letter-spacing: var(--tracking-display-light);
    color: var(--color-text-on-dark);
    text-wrap: pretty;
  }

  .hero-con__bajada {
    max-width: 40ch;
    font: 400 clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem) / 1.6 var(--font-body);
    color: var(--color-text-on-dark);
    text-wrap: pretty;
  }
</style>
