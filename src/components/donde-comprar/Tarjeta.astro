---
/**
 * Tarjeta de un punto de venta (`.card` del prototipo): nombre, ciudad, los
 * datos de contacto y hasta tres acciones.
 *
 * Contenido defensivo: cada dato que el CMS no trae desaparece —dirección,
 * horario, teléfono, WhatsApp y correo son opcionales en el schema—, sin dejar
 * la fila en blanco ni escribir "no especificado".
 *
 * El nombre no es un encabezado sino el rótulo del `<article>` (igual que el
 * `<span>` del prototipo): la página tiene un solo h1 y un h2 —el de la banda
 * de cierre—, y meter un h3 acá abriría un salto de jerarquía.
 */
import type {Distribuidor} from '~/lib/data'
import {textoBuscable} from './datos'

interface Props {
  punto: Distribuidor
}

const {punto} = Astro.props

// Lucide, los mismos trazos del prototipo.
const ICONO_TELEFONO =
  'M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384'
const ICONO_WHATSAPP =
  'M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z'

const telefonoLimpio = punto.telefono?.replace(/\s/g, '')
---

<article class="tarjeta" aria-label={punto.nombre} data-punto data-buscable={textoBuscable(punto)}>
  <div class="tarjeta__cabeza">
    <p class="tarjeta__nombre">{punto.nombre}</p>
    <span class="tarjeta__ciudad">{punto.ciudad}</span>
  </div>

  <div class="tarjeta__datos">
    {punto.direccion && <span>{punto.direccion}</span>}
    <span>{punto.estado}</span>
    {punto.horario && <span>{punto.horario}</span>}
  </div>

  {
    (punto.telefono || punto.whatsapp || punto.correo) && (
      <div class="tarjeta__acciones">
        {punto.telefono && (
          <a class="accion" href={`tel:${telefonoLimpio}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={ICONO_TELEFONO} />
            </svg>
            {punto.telefono}
          </a>
        )}
        {punto.whatsapp && (
          <a class="accion" href={`https://wa.me/${punto.whatsapp}`} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={ICONO_WHATSAPP} />
            </svg>
            <span>WhatsApp</span>
            <span class="visualmente-oculto">de {punto.nombre}</span>
          </a>
        )}
        {punto.correo && (
          <a class="accion accion--correo" href={`mailto:${punto.correo}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span>Correo</span>
            <span class="visualmente-oculto">de {punto.nombre}</span>
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .tarjeta {
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border-hairline);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color var(--dur-respuesta) var(--ease-respuesta);
  }

  .tarjeta[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .tarjeta:hover {
      border-color: var(--color-text-muted);
    }
  }

  .tarjeta__cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .tarjeta__nombre {
    font: 500 1.0625rem/normal var(--font-heading);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-primary);
  }

  .tarjeta__ciudad {
    font: var(--text-nav);
    letter-spacing: var(--tracking-uppercase-md);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .tarjeta__datos {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font: 400 0.8125rem/1.55 var(--font-body);
    color: var(--color-text-secondary);
  }

  .tarjeta__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  /* El prototipo declara 40px acá y 44 en teléfono. `Tokens v0` fija la altura
     de control en 44 y el piso de toque es el mismo número: manda el token,
     como ya se resolvió en Profesionales y en Encuéntranos. */
  .accion {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height-md);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-brand-700);
    color: var(--color-brand-700);
    font: var(--text-nav);
    letter-spacing: var(--tracking-uppercase-sm);
    text-transform: uppercase;
    transition:
      background-color var(--dur-instant) var(--ease-out),
      color var(--dur-instant) var(--ease-out),
      border-color var(--dur-instant) var(--ease-out);
  }

  .accion:hover,
  .accion:active {
    background: var(--color-brand-700);
    color: var(--color-action-on-primary);
  }

  .accion--correo {
    border-color: var(--color-border-hairline);
    color: var(--color-text-secondary);
  }

  .accion--correo:hover,
  .accion--correo:active {
    background: transparent;
    border-color: var(--color-text-secondary);
    color: var(--color-text-primary);
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* En teléfono las tres acciones reparten el ancho: dedo entero, sin puntería. */
  @media (max-width: 759px) {
    .accion {
      flex: 1;
      justify-content: center;
    }
  }
</style>
