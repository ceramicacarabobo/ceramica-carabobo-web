---
/**
 * Acción al pulgar de esta página: WhatsApp con el número central
 * (`Responsividad v0` §03, fila "Acción al pulgar").
 *
 * Solo en teléfono, y solo mientras hace falta: aparece cuando el hero sale de
 * cuadro y se retira al llegar a la banda de cierre, donde el mismo botón ya
 * está en el contenido. No es navegación: los destinos siguen en el menú.
 */
interface Props {
  whatsapp: string
}

const {whatsapp} = Astro.props
---

<div class="pulgar" data-pulgar hidden>
  <a class="pulgar__cta" href={whatsapp} target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"></path>
    </svg>
    Escríbenos por WhatsApp
  </a>
</div>

<style>
  .pulgar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-scrim);
    padding: var(--space-3) var(--space-5) calc(var(--space-3) + env(safe-area-inset-bottom));
    background: var(--color-surface-base);
    border-top: var(--border-width) solid var(--color-border-hairline);
    animation: pulgar-entra var(--dur-reveal) var(--ease-editorial) both;
  }

  .pulgar[hidden] {
    display: none;
  }

  .pulgar__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--control-height-lg);
    padding-inline: var(--space-8);
    background: var(--color-action-primary);
    border: var(--border-width) solid var(--color-action-primary);
    color: var(--color-action-on-primary);
    font: var(--text-ui-sm);
    letter-spacing: var(--tracking-uppercase-md);
    text-transform: uppercase;
    transition:
      background-color var(--dur-instant) var(--ease-out),
      transform var(--dur-instant) var(--ease-out);
  }

  .pulgar__cta:hover {
    background: var(--color-action-primary-hover);
    border-color: var(--color-action-primary-hover);
    color: var(--color-action-on-primary);
  }

  .pulgar__cta:active {
    transform: translateY(1px);
  }

  @keyframes pulgar-entra {
    from {
      opacity: 0;
      transform: translateY(100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Desde tablet la acción vive en el contenido y en la cabecera. */
  @media (min-width: 760px) {
    .pulgar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulgar {
      animation: none;
    }
  }
</style>

<script>
  function iniciarPulgar() {
    const barra = document.querySelector<HTMLElement>('[data-pulgar]')
    if (!barra || barra.dataset.enganchada !== undefined) return
    barra.dataset.enganchada = ''
    if (!('IntersectionObserver' in window)) return

    const hero = document.querySelector('.hero-dc')
    const cierre = document.querySelector('.cierre-dc') ?? document.querySelector('footer')

    let fueraDelHero = false
    let enElCierre = false
    const aplicar = () => {
      barra.hidden = !(fueraDelHero && !enElCierre)
    }

    if (hero) {
      new IntersectionObserver((entradas) => {
        fueraDelHero = !entradas[0].isIntersecting
        aplicar()
      }).observe(hero)
    }
    if (cierre) {
      new IntersectionObserver((entradas) => {
        enElCierre = entradas[0].isIntersecting
        aplicar()
      }).observe(cierre)
    }
  }

  iniciarPulgar()
  document.addEventListener('astro:page-load', iniciarPulgar)
</script>
