---
/**
 * Pie del sitio. Reflow de `Responsividad v0` §03:
 * desktop 3 columnas (storytelling + 2 de enlaces), tablet 2, móvil 1 en el
 * mismo orden, con 44px de separación entre enlaces.
 * Estructura fija; todos los textos y datos vienen del CMS.
 */
import Lockup from './Lockup.astro'
import type {Ajustes} from '~/lib/data'

interface Props {
  ajustes: Ajustes
}

const {ajustes} = Astro.props
const anio = new Date().getFullYear()

const telefonoEnlace = ajustes.telefono?.replace(/[^\d+]/g, '')
---

<footer class="pie" transition:persist="pie">
  <div class="pie__interior">
    <div class="pie__marca">
      <a class="pie__lockup" href="/" aria-label="Cerámica Carabobo — inicio">
        <Lockup variante="apilada" />
      </a>
      {ajustes.textoPie && <p class="pie__texto">{ajustes.textoPie}</p>}
    </div>

    <nav class="pie__bloque" aria-label="Pie de página">
      <h2 class="overline pie__titulo">Navegación</h2>
      <ul class="pie__lista">
        <li><a class="pie__enlace" href="/catalogo">Catálogo</a></li>
        <li><a class="pie__enlace" href="/donde-comprar">Distribuidores</a></li>
        <li><a class="pie__enlace" href="/contacto">Contacto</a></li>
      </ul>
    </nav>

    <div class="pie__bloque">
      <h2 class="overline pie__titulo">Contacto</h2>
      <ul class="pie__lista">
        {ajustes.direccion && <li class="pie__dato">{ajustes.direccion}</li>}
        {telefonoEnlace && (
          <li><a class="pie__enlace pie__enlace--telefono" href={`tel:${telefonoEnlace}`}>{ajustes.telefono}</a></li>
        )}
        {ajustes.correo && (
          <li><a class="pie__enlace pie__enlace--correo" href={`mailto:${ajustes.correo}`}>{ajustes.correo}</a></li>
        )}
      </ul>
    </div>
  </div>

  <p class="pie__legal">
    © {anio} {ajustes.titulo}. Todos los derechos reservados.
  </p>
</footer>

<style>
  /* El pie va sobre NEUTRO CÁLIDO, no sobre #2E2E2E. Lo dice la regla de la
     propuesta A —"brand como acento, nunca como superficie de sección; cierres
     y footer sobre neutro cálido; #2E2E2E tampoco es fondo de sección salvo
     debajo de imagery, p.ej. hero"— y lo confirma el prototipo, cuyo <footer>
     declara `background:#F5F3F0; border-top:1px solid #D9D9D9`.
     Estaba invertido: fondo oscuro con el juego de tokens `on-dark`. Los seis
     colores del prototipo ya existían como tokens; no se inventó ninguno. */
  /* El pie declara su propio ritmo con `clamp()` y NO con los tokens generales
     de espaciado: son curvas distintas y en móvil la diferencia se acumula (el
     pie salía 19% más alto, medido). Valores literales del prototipo. */
  .pie {
    background: var(--color-surface-base);
    border-top: var(--border-width) solid var(--color-border-hairline);
    color: var(--color-text-secondary);
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 72px) 32px;
    padding-bottom: max(32px, env(safe-area-inset-bottom));
  }

  .pie__interior,
  .pie__legal {
    max-width: var(--size-content-max);
    margin-inline: auto;
  }

  .pie__interior {
    display: grid;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .pie__lockup {
    display: inline-flex;
    color: var(--color-brand-900);
  }

  .pie__texto {
    margin-top: 24px;
    max-width: 38ch;
    font: var(--text-body-15);
    color: var(--color-text-secondary);
  }

  .pie__titulo {
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  /* 12px entre enlaces. Estaba en `grid` sin `gap`, así que quedaban pegados y
     solo los separaba su propio alto mínimo. */
  .pie__lista {
    display: grid;
    gap: 12px;
  }

  .pie__enlace,
  .pie__dato {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-secondary);
    font: var(--text-body-base);
  }

  /* El teléfono lleva tratamiento propio en el diseño: es el único dato del pie
     que se lee como cifra y no como texto. */
  .pie__enlace--telefono {
    font-family: var(--font-heading);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .pie__enlace:hover {
    color: var(--color-text-link);
  }

  /* El correo va en vinotinto SIEMPRE, no solo al pasar el cursor: es el único
     elemento del pie que el prototipo pinta con el color de marca, y encaja con
     la regla de "brand como acento". Sin esto el pie no tiene ningún acento. */
  .pie__enlace--correo {
    color: var(--color-text-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pie__legal {
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border-hairline);
    color: var(--color-text-muted);
    font: var(--text-caption);
  }

  @media (min-width: 760px) {
    .pie__interior {
      grid-template-columns: 1fr 1fr;
    }

    .pie__marca {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .pie__interior {
      grid-template-columns: 2fr 1fr 1fr;
    }

    .pie__marca {
      grid-column: auto;
    }
  }
</style>
