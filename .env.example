# ---------------------------------------------------------------------------
# Sanity — el projectId sale de sanity.io/manage al crear el proyecto (Fase 1).
# Mientras no exista el proyecto, dejar `placeholder`: el sitio compila y el
# adaptador de datos devuelve contenido vacío (secciones bajo su mínimo se
# ocultan, según la regla de contenido defensivo del handoff).
# ---------------------------------------------------------------------------
PUBLIC_SANITY_PROJECT_ID="placeholder"
PUBLIC_SANITY_DATASET="production"

# Token de solo lectura (Sanity → API → Tokens). Necesario únicamente para leer
# borradores en el deploy de preview/visual editing. El build de producción lee
# contenido publicado y no lo necesita.
SANITY_API_READ_TOKEN=""

# "true" SOLO en el deploy de preview: cambia el build a server-rendered para
# que funcionen los overlays del Presentation Tool. En producción: ausente.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED="false"

# URL del deploy de preview (server-rendered). El Presentation Tool del Studio
# abre el sitio ahí para el click-to-edit. Vacío = mismo origen (dev).
PUBLIC_SANITY_PREVIEW_URL=""

# URL absoluta del Studio. El preview corre en otro dominio que el Studio, así
# que los overlays de visual editing necesitan la dirección completa.
PUBLIC_SANITY_STUDIO_URL=""

# URL pública del deploy (canonical, OG, sitemap).
SITE_URL="http://localhost:4321"

# --- Cloudflare (para desplegar desde la terminal) ---
# Token: dash.cloudflare.com/profile/api-tokens (plantilla "Edit Cloudflare Workers").
# Account ID: se ve con `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Entorno del despliegue: "qa" | "preview" | "produccion".
# Cualquier valor distinto de "produccion" bloquea la indexación (meta robots +
# robots.txt). Se cambia a "produccion" recién en la Fase 7.
PUBLIC_ENTORNO="qa"
